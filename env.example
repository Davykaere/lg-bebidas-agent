# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sua_chave_aqui

# Token de acesso do WhatsApp (Meta for Developers > seu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=seu_token_aqui

# Phone Number ID (aparece na mesma tela do token, "From" > Phone number ID)
WHATSAPP_PHONE_ID=seu_phone_number_id_aqui

# Token que VOCÊ inventa, usado só para validar o webhook com a Meta
VERIFY_TOKEN=escolha_uma_senha_forte_aqui

PORT=3000
